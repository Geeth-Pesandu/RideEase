@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - RideEase</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    <!-- AOS Animation CSS -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            padding: 0;
        }

        .navbar-brand {
            font-weight: bold;
            color: #2c3e50;
        }

        footer {
            background-color: #2c3e50;
            color: white;
            padding: 40px 0;
        }

            footer a {
                color: #ccc;
                text-decoration: none;
            }

                footer a:hover {
                    color: white;
                    text-decoration: underline;
                }
    </style>

    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />

</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light px-4">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <img src="~/Images/logo.jpg" alt="RideEase Logo" style="height: 50px;" />
            <span class="fw-bold fs-4 text-primary">RideEase</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav" aria-controls="navbarNav"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/Vehicle/Fleet">Our Fleet</a></li>
                <li class="nav-item">
                    <a class="nav-link" href="/Home/About">About Us</a>
                </li>

                <li class="nav-item"><a class="nav-link" href="/Home/Contact">Contact</a></li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Booking")">My Bookings</a>
                </li>

                @using Microsoft.AspNet.Identity

                @if (Request.IsAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link">Hello, @User.Identity.GetUserName()!</span>
                    </li>
                    <li class="nav-item">
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger ms-2">Logout</button>
                        }
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary ms-2" href="/Account/Register">Sign Up</a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-warning" href="@Url.Action("AllBookings", "Admin")">Admin Dashboard</a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Vehicles">Admin Panel</a>
                    </li>
                }



            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="mt-5">
        <div class="container text-center text-md-start">
            <div class="row">
                <!-- Help Section -->
                <div class="col-md-3">
                    <h5>Help Center</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">User Guide</a></li>
                        <li><a href="#">Feedback</a></li>
                        <li><a href="#">Community</a></li>
                    </ul>
                </div>
                <!-- Resources -->
                <div class="col-md-3">
                    <h5>Resources</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Cookie Settings</a></li>
                    </ul>
                </div>
                <!-- Company Info -->
                <div class="col-md-3">
                    <h5>Company</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">FAQ</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <!-- Social Media -->
                <div class="col-md-3">
                    <h5>Stay Connected</h5>
                    <a href="#"><img src="~/Images/facebook.png" alt="Facebook" style="height: 24px; margin-right: 8px;" /></a>
                    <a href="#"><img src="~/Images/twitter.png" alt="Twitter" style="height: 24px; margin-right: 8px;" /></a>
                    <a href="#"><img src="~/Images/instagram.png" alt="Instagram" style="height: 24px; margin-right: 8px;" /></a>
                    <a href="#"><img src="~/Images/youtube.png" alt="YouTube" style="height: 24px;" /></a>
                </div>
            </div>
            <hr />
            <div class="text-center mt-3">
                <p>&copy; 2025 RideEase. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init();

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>


</body>
</html>
