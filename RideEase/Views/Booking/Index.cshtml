@model IEnumerable<RideEase.Models.Booking>

@{
    ViewBag.Title = "My Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">My Bookings</h2>

<!-- 🔢 Status Counts -->
<div class="mb-3">
    <span class="badge bg-success me-2">Approved: @ViewBag.ApprovedCount</span>
    <span class="badge bg-warning text-dark me-2">Pending: @ViewBag.PendingCount</span>
    <span class="badge bg-danger">Rejected: @ViewBag.RejectedCount</span>
</div>

<!-- 🔎 Filter Dropdown -->
@using (Html.BeginForm("Index", "Booking", FormMethod.Get, new { @class = "mb-4 d-flex align-items-center" }))
{
    <label class="me-2 fw-bold">Filter by Status:</label>
    <select name="status" class="form-select form-select-sm me-2" style="width: 200px;">
        <option value="">All</option>
        @foreach (var s in Enum.GetNames(typeof(RideEase.Models.BookingStatus)))
        {
            <option value="@s" @(ViewBag.SelectedStatus == s ? "selected" : "")>@s</option>
        }
    </select>
    <button type="submit" class="btn btn-sm btn-outline-primary">Apply</button>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't made any bookings yet.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Image</th>
                <th>Vehicle</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Price/Day</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                var vehicle = booking.Vehicle;
                var days = (booking.EndDate - booking.StartDate).Days;
                var total = (vehicle != null) ? days * vehicle.PricePerDay : 0;

                <tr>
                    <td>
                        <img src="@(vehicle?.ImageUrl ?? "/Images/default.png")"
                             alt="@vehicle?.Name"
                             style="width: 100px; height: 60px; object-fit: cover;" />
                    </td>
                    <td>@(vehicle?.Name ?? "N/A")</td>
                    <td>@booking.StartDate.ToShortDateString()</td>
                    <td>@booking.EndDate.ToShortDateString()</td>
                    <td>Rs. @(vehicle?.PricePerDay.ToString("N0") ?? "0")</td>
                    <td>Rs. @total</td>
                    <td>
                        <span class="badge
                            @(booking.Status == RideEase.Models.BookingStatus.Approved ? "bg-success" :
                              booking.Status == RideEase.Models.BookingStatus.Rejected ? "bg-danger" :
                              "bg-warning text-dark")">
                            @booking.Status
                        </span>
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = booking.Id }, new { @class = "btn btn-sm btn-outline-primary me-1" })

                        @using (Html.BeginForm("Cancel", "Booking", FormMethod.Post, new
                        {
                            onsubmit = "return confirm('Are you sure you want to cancel this booking?');",
                            @class = "d-inline"
                        }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", booking.Id)
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
