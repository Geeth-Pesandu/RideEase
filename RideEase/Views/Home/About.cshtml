@{
    ViewBag.Title = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5 bg-light">
    <div class="container text-center">
        <h2 class="fw-bold mb-4">About RideEase</h2>
        <p class="lead text-muted mb-4">
            RideEase is Sri Lanka's premier vehicle rental platform — offering a wide range of options including cars, vans, tuk tuks, and scooters.
        </p>
        <div class="row">
            <div class="col-md-6">
                <img src="~/Images/about.jpg" class="img-fluid rounded shadow-sm" alt="About RideEase" />
            </div>
            <div class="col-md-6 text-start">
                <h4 class="mt-3">Our Mission</h4>
                <p>To simplify transportation for everyone through accessible, affordable, and reliable vehicle rentals.</p>

                <h4>What Makes Us Different</h4>
                <ul>
                    <li>✔️ Wide range of vehicles</li>
                    <li>✔️ Smart booking interface</li>
                    <li>✔️ Trusted by 1000+ happy customers</li>
                </ul>
            </div>
        </div>
    </div>
</section>



